diff --git a/src/libopensc/card-idprime.c b/src/libopensc/card-idprime.c
index 6c3e079..dee19e2 100644
--- a/src/libopensc/card-idprime.c
+++ b/src/libopensc/card-idprime.c
@@ -278,6 +278,27 @@ static int idprime_select_idprime(sc_card_t *card)
 	return iso_ops->select_file(card, &idprime_path, NULL);
 }
 
+/* After a reset the card starts in its default applet, not IDPrime: an
+ * IDPrime 940 on macOS is reset after ~10 s idle, and a PIN command then
+ * gets 6D00 (the default applet does not know VERIFY, so the command did
+ * not run and used no PIN try). Select IDPrime and send the command once
+ * more. Other answers are left alone, so a verified PIN is never dropped. */
+static int idprime_pin_cmd(sc_card_t *card, struct sc_pin_cmd_data *data)
+{
+	int r;
+
+	SC_FUNC_CALLED(card->ctx, SC_LOG_DEBUG_VERBOSE);
+
+	r = iso_ops->pin_cmd(card, data);
+	if (r == SC_ERROR_INS_NOT_SUPPORTED || r == SC_ERROR_CLASS_NOT_SUPPORTED) {
+		sc_log(card->ctx, "PIN command not known to the selected applet, re-selecting IDPrime");
+		if (idprime_select_idprime(card) == SC_SUCCESS)
+			r = iso_ops->pin_cmd(card, data);
+	}
+
+	LOG_FUNC_RETURN(card->ctx, r);
+}
+
 /* Select file by string path */
 static int idprime_select_file_by_path(sc_card_t *card, const char *str_path)
 {
@@ -1266,6 +1287,7 @@ static struct sc_card_driver * sc_get_driver(void)
 	idprime_ops.read_binary = idprime_read_binary;
 	idprime_ops.select_file = idprime_select_file;
 	idprime_ops.card_ctl = idprime_card_ctl;
+	idprime_ops.pin_cmd = idprime_pin_cmd;
 	idprime_ops.set_security_env = idprime_set_security_env;
 	idprime_ops.compute_signature = idprime_compute_signature;
 	idprime_ops.decipher = idprime_decipher;
